PORT=3000

# Database
# Local co the dung MySQL. Render/Supabase bat buoc dung PostgreSQL.
DB_CLIENT=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=joblink_db
# Supabase Session pooler (port 5432) cho backend Render chay lau dai:
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage (chi dat secret o backend, tuyet doi khong dua vao public/js)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Du an cu co the dung legacy key nay thay SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=joblink-public
SUPABASE_CV_BUCKET=joblink-cv

# JWT
JWT_SECRET=doi_thanh_mot_chuoi_bi_mat_rieng_cua_ban
JWT_EXPIRES_IN=7d

# Session (dung cho OAuth redirect)
SESSION_SECRET=doi_thanh_chuoi_khac_cua_ban

# URL goc cua ung dung (khong co dau / o cuoi)
BASE_URL=http://localhost:3000

# Thanh toan chuyen khoan/VietQR
PAYMENT_BANK_ID=VCB
PAYMENT_BANK_NAME=Vietcombank
PAYMENT_ACCOUNT_NUMBER=your_account_number
PAYMENT_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
PAYMENT_BANK_BRANCH=your_bank_branch
PAYMENT_QR_TEMPLATE=compact2

# Email dat lai mat khau (de trong khi chay local de nhan link test tren giao dien)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=JobLink <no-reply@joblink.vn>

# ──────────────────────────────────────────────────────────────
# OAUTH - dang nhap mang xa hoi (tuy chon, bo trong neu khong dung)
# Huong dan lay credentials o cuoi file nay
# ──────────────────────────────────────────────────────────────

# Google OAuth
# Lay tai: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Lay tai: https://github.com/settings/developers → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook OAuth (can HTTPS tren production)
# Lay tai: https://developers.facebook.com → My Apps → Create App
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# AI Service (Flask - mac dinh localhost:5000)
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_HOST=
AI_SERVICE_TOKEN=
AI_TIMEOUT_MS=120000
AI_LIGHTWEIGHT_MODE=false

# Groq API cho chatbot RAG
# Lay key tai: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chi dung mot lan de tao admin production bang: npm run admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# HUONG DAN LAY OAUTH CREDENTIALS
# ──────────────────────────────────────────────────────────────
#
# === GOOGLE ===
# 1. Vao https://console.cloud.google.com
# 2. Tao project moi (hoac chon project co san)
# 3. APIs & Services > OAuth consent screen > External > tao
# 4. APIs & Services > Credentials > Create > OAuth 2.0 Client IDs
# 5. Application type: Web application
# 6. Authorized redirect URIs: them http://localhost:3000/api/auth/google/callback
# 7. Copy Client ID va Client Secret vao day
#
# === GITHUB ===
# 1. Vao https://github.com/settings/developers
# 2. OAuth Apps > New OAuth App
# 3. Homepage URL: http://localhost:3000
# 4. Authorization callback URL: http://localhost:3000/api/auth/github/callback
# 5. Register application > copy Client ID va generate Client Secret
#
# === FACEBOOK ===
# 1. Vao https://developers.facebook.com/apps
# 2. Create App > Consumer > Next
# 3. Them san pham Facebook Login > Set Up
# 4. Valid OAuth Redirect URIs: http://localhost:3000/api/auth/facebook/callback
# 5. App ID va App Secret o Settings > Basic
# Luu y: Facebook yeu cau HTTPS tren production, localhost OK de test
