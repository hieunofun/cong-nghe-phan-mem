# =============================================================
# Dockerfile cho Dịch vụ AI JobLink (Python Flask - Lightweight Mode)
# =============================================================
FROM python:3.11-slim

WORKDIR /app

# Tối ưu output và bộ nhớ Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_LIGHTWEIGHT_MODE=true \
    PORT=5000

# Cài đặt dependencies hỗ trợ MySQL
COPY ai_service/requirements.render.txt ./
RUN pip install --no-cache-dir -r requirements.render.txt pymysql

# Copy toàn bộ code dịch vụ AI
COPY ai_service/ ./ai_service/

EXPOSE 5000

CMD ["python", "ai_service/app.py"]
