# =============================================================
# Dockerfile cho Dịch vụ AI JobLink (Python Flask + Gunicorn WSGI)
# Production-hardened: Non-root user, Gunicorn workers, Healthcheck
# =============================================================
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_LIGHTWEIGHT_MODE=true \
    PORT=5000

# Tạo non-root system user an toàn
RUN useradd --system --uid 1001 --create-home appuser

# Cài đặt dependencies hỗ trợ cả PostgreSQL và MySQL cùng Gunicorn WSGI
COPY ai_service/requirements.render.txt ./
RUN pip install --no-cache-dir -r requirements.render.txt pymysql

# Copy toàn bộ code dịch vụ AI và gán quyền cho non-root user
COPY --chown=appuser:appuser ai_service/ ./ai_service/
RUN mkdir -p /app/ai_service/.cache/huggingface && chown -R appuser:appuser /app

EXPOSE 5000

USER appuser

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=4)"

CMD ["gunicorn", "--chdir", "ai_service", "app:app", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--timeout", "120", "--access-logfile", "-"]
