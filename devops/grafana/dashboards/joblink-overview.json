{
  "uid": "joblink-overview",
  "title": "JobLink — Giám sát toàn diện (Full-Stack Observability)",
  "tags": [
    "joblink",
    "final",
    "docker",
    "observability"
  ],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Gateway / Nginx",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "probe_success{job=\"joblink-probes\",service=\"gateway\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "title": "Web / Express (Prod)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 4, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "probe_success{job=\"joblink-probes\",service=\"web\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
