        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "MySQL 8.0 TCP",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "probe_success{job=\"joblink-probes\",service=\"mysql\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
