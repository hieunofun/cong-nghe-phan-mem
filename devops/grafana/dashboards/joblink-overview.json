              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "title": "Web → MySQL / Jobs API",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "probe_success{job=\"joblink-probes\",service=\"database-api\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "title": "Thời gian phản hồi / Probe Response Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"joblink-probes\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 7,
      "title": "Lịch sử trạng thái / Availability Timeline",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "probe_success{job=\"joblink-probes\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 0, "fillOpacity": 85, "spanNulls": false },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.82,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 8,
      "title": "Lưu lượng ứng dụng / White-Box Request Rate (RPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 11, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(joblink_http_requests_total[1m]))",
          "legendFormat": "Web RPS",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        },
        {
          "expr": "sum(rate(joblink_ai_requests_total[1m]))",
          "legendFormat": "AI RPS",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        },
        {
          "expr": "sum(rate(joblink_http_errors_total{status_class=\"5xx\"}[1m])) or vector(0)",
          "legendFormat": "Web 5xx/s",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 9,
      "title": "Độ trễ API nội tại / Web p95 Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 8, "y": 11, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(joblink_http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "Web p95",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        },
        {
          "expr": "nodejs_eventloop_lag_seconds",
          "legendFormat": "Event Loop Lag",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 10,
      "title": "Bộ nhớ Node.js / Container Memory (RSS & Heap)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 16, "y": 11, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "nodejs_resident_memory_bytes",
          "legendFormat": "RSS Memory",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        },
        {
          "expr": "nodejs_heap_used_bytes",
          "legendFormat": "V8 Heap Used",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 11,
      "title": "Tỷ lệ kiểm tra thành công / Last 15 min Availability",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "100 * avg_over_time(probe_success{job=\"joblink-probes\"}[15m])",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 12,
      "title": "Cảnh báo đang kích hoạt / Active Alerts",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 12, "y": 18, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum(ALERTS{alertname=~\"JobLink.*\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 13,
      "title": "Alertmanager đã gửi / Webhook Notifications",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 18, "y": 18, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum(joblink_alert_notifications_total) or vector(0)",
          "legendFormat": "Delivered",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    }
  ],
  "annotations": { "list": [] }
}
