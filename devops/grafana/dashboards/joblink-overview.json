    {
      "id": 3,
      "title": "AI / Gunicorn WSGI",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "probe_success{job=\"joblink-probes\",service=\"ai\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
