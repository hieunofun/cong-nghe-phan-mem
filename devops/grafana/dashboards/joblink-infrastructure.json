{
  "uid": "joblink-infrastructure",
  "title": "JobLink — Hạ tầng Host & Containers (Node Exporter + cAdvisor)",
  "tags": ["joblink", "infrastructure", "node-exporter", "cadvisor"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Host CPU Utilization (%) — Node Exporter",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))) * 100",
          "legendFormat": "Host CPU %",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Host Memory Usage (%) — Node Exporter",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Host RAM %",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Host Root Filesystem Available (%) — Node Exporter",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 5 },
      "targets": [
        {
          "expr": "(node_filesystem_avail_bytes{mountpoint=\"/rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/rootfs\"}) * 100",
          "legendFormat": "Disk Free %",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Container CPU Usage (cores) — cAdvisor",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 8, "y": 7, "w": 16, "h": 7 },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"joblink-.*\"}[1m]))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Container Memory Working Set (MiB) — cAdvisor",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"joblink-.*\"} / 1048576",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "mebibytes" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Container Network RX/TX (bytes/s) — cAdvisor",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "joblink-prometheus" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"joblink-.*\"}[1m]))",
          "legendFormat": "RX {{name}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        },
        {
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"joblink-.*\"}[1m]))",
          "legendFormat": "TX {{name}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "joblink-prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    }
  ]
}
