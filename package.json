{
  "name": "joblink-recruitment-platform",
  "version": "1.0.0",
  "description": "Nền tảng tuyển dụng kết nối Doanh nghiệp và Ứng viên (kiểu TopCV)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node scripts/apply-supabase-migration.js --if-configured --best-effort",
    "start": "node server.js",
    "ai": "python ai_service/app.py",
    "dev": "node --watch server.js",
    "build:frontend": "node scripts/write-frontend-env.js",
    "test": "node --test tests/*.test.js",
    "test:ai": "python -m unittest ai_service.test_multilingual_matching",
    "test:checkout-render": "node scripts/test-checkout-render.js",
    "seed": "node database/seed.js",
    "admin:create": "node scripts/create-admin.js",
    "migrate:accents": "node database/accent_migration.js",
    "mysql:migrate": "node scripts/apply-mysql-migration.js",
    "db:backup": "node scripts/db-backup.js backup",
    "db:restore": "node scripts/db-backup.js restore",
    "devops:up": "node scripts/devops-demo.js up",
    "devops:build": "node scripts/devops-demo.js build",
    "devops:check": "node scripts/devops-demo.js check",
    "devops:stop": "node scripts/devops-demo.js stop",
    "supabase:migrate": "node scripts/apply-supabase-migration.js",
    "supabase:storage": "node scripts/setup-supabase-storage.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.6.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0"
  }
}
